{
  "name": "ai-cooperation",
  "version": "0.3.1",
  "private": true,
  "author": "zhangmaofa <zhangmaofa@users.noreply.github.com>",
  "description": "Local-first AI agent coordinator with persistent tasks and pluggable execution adapters",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhangmaofa/AI-Cooperation.git"
  },
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "start": "npm run build:ui && electron .",
    "build:ui": "tsc --noEmit && vite build",
    "package:win": "npm run build:ui && node scripts/package.mjs",
    "test:desktop": "npm run build:ui && node --test desktop-test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "demo": "node demo.mjs",
    "mcp": "node mcp.mjs"
  }
}
